<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<VBox fx:id="rootContainer"
      alignment="CENTER"
      spacing="20.0"
      stylesheets="@styles.css"
      xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/8"
      fx:controller="org.example.csc311progresscheckassignment.StartController">

   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
   </padding>

   <children>
      <Pane styleClass="game-pane"
            prefHeight="470.0"
            prefWidth="667.0">

         <children>

            <Button fx:id="startButton"
                    onAction="#startGame"
                    layoutX="286.0"
                    layoutY="415.0"
                    mnemonicParsing="false"
                    prefHeight="31.0"
                    prefWidth="95.0"
                    text="START"/>

            <Rectangle fx:id="expressionDisplayBar"
                       styleClass="section-bar"
                       arcHeight="5.0"
                       arcWidth="5.0"
                       height="31.0"
                       layoutX="28.0"
                       layoutY="80.0"
                       strokeType="INSIDE"
                       width="435.0"/>

            <Rectangle fx:id="cardOneSlot"
                       styleClass="card-slot"
                       arcHeight="5.0"
                       arcWidth="5.0"
                       height="200.0"
                       layoutX="14.0"
                       layoutY="135.0"
                       strokeType="INSIDE"
                       width="132.0"/>

            <Rectangle fx:id="cardTwoSlot"
                       styleClass="card-slot"
                       arcHeight="5.0"
                       arcWidth="5.0"
                       height="200.0"
                       layoutX="182.0"
                       layoutY="135.0"
                       strokeType="INSIDE"
                       width="132.0"/>

            <Rectangle fx:id="cardThreeSlot"
                       styleClass="card-slot"
                       arcHeight="5.0"
                       arcWidth="5.0"
                       height="200.0"
                       layoutX="354.0"
                       layoutY="135.0"
                       strokeType="INSIDE"
                       width="132.0"/>

            <Rectangle fx:id="cardFourSlot"
                       styleClass="card-slot"
                       arcHeight="5.0"
                       arcWidth="5.0"
                       height="200.0"
                       layoutX="521.0"
                       layoutY="135.0"
                       strokeType="INSIDE"
                       width="132.0"/>

            <TextField fx:id="displayExpression"
                       editable="false"
                       layoutX="163.0"
                       layoutY="80.0"
                       prefHeight="31.0"
                       prefWidth="305.0"
                       promptText="Your Formula Will Display Here"/>

            <Label fx:id="entryLabel"
                   layoutX="32.0"
                   layoutY="85.0"
                   prefHeight="21.0"
                   prefWidth="132.0"
                   text="      YOU ENTERED:"/>

            <Rectangle fx:id="inputExpressionBar"
                       styleClass="section-bar"
                       arcHeight="5.0"
                       arcWidth="5.0"
                       height="31.0"
                       layoutX="31.0"
                       layoutY="366.0"
                       strokeType="INSIDE"
                       width="435.0"/>

            <Label fx:id="expressionLabel"
                   layoutX="34.0"
                   layoutY="370.0"
                   prefHeight="21.0"
                   prefWidth="132.0"
                   text="  Enter an Expression:"/>

            <TextField fx:id="enterExpression"
                       layoutX="158.0"
                       layoutY="366.0"
                       prefHeight="31.0"
                       prefWidth="313.0"
                       promptText="Enter the Expression Here"/>

            <Button fx:id="themeButton"
                    onAction="#changeTheme"
                    layoutX="521.0"
                    layoutY="80.0"
                    mnemonicParsing="false"
                    prefHeight="31.0"
                    prefWidth="132.0"
                    text="CHANGE THEME"/>

            <Button fx:id="verifyButton"
                    layoutX="486.0"
                    layoutY="365.0"
                    mnemonicParsing="false"
                    prefHeight="31.0"
                    prefWidth="80.0"
                    text="VERIFY"/>

            <Button fx:id="reshuffleButton"
                    onAction="#reshuffleCards"
                    layoutX="573.0"
                    layoutY="365.0"
                    mnemonicParsing="false"
                    prefHeight="31.0"
                    prefWidth="80.0"
                    text="RESHUFFLE"/>

            <Label fx:id="pickingFirstCardText"
                   disable="true"
                   layoutX="38.0"
                   layoutY="227.0"
                   text="Picking a Card..."/>

            <Label fx:id="pickingSecondCardText"
                   disable="true"
                   layoutX="207.0"
                   layoutY="227.0"
                   text="Picking a Card..."/>

            <Label fx:id="pickingThirdCardText"
                   disable="true"
                   layoutX="378.0"
                   layoutY="227.0"
                   text="Picking a Card..."/>

            <Label fx:id="pickingFourthCardText"
                   disable="true"
                   layoutX="545.0"
                   layoutY="227.0"
                   text="Picking a Card..."/>

            <ImageView fx:id="cardOneDisplay"
                       fitHeight="182.0"
                       fitWidth="118.0"
                       layoutX="21.0"
                       layoutY="145.0"
                       pickOnBounds="true"
                       preserveRatio="true"/>

            <ImageView fx:id="cardTwoDisplay"
                       fitHeight="182.0"
                       fitWidth="118.0"
                       layoutX="190.0"
                       layoutY="144.0"
                       pickOnBounds="true"
                       preserveRatio="true"/>

            <ImageView fx:id="cardThreeDisplay"
                       fitHeight="182.0"
                       fitWidth="118.0"
                       layoutX="361.0"
                       layoutY="145.0"
                       pickOnBounds="true"
                       preserveRatio="true"/>

            <ImageView fx:id="cardFourDisplay"
                       fitHeight="182.0"
                       fitWidth="118.0"
                       layoutX="528.0"
                       layoutY="144.0"
                       pickOnBounds="true"
                       preserveRatio="true"/>

         </children>
      </Pane>
   </children>
</VBox>
